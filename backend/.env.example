# =====================================================================
# VYRA Interview Engine - Environment Configuration Example
# =====================================================================
# Copy this file to .env before starting the backend:
#   copy .env.example .env
#
# DO NOT commit .env with actual API keys or secrets to version control.
# =====================================================================

# Google Gemini API Configuration (For Gemini reasoning provider)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama AI Provider Configuration (Current legacy provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=150.0
OLLAMA_NUM_GPU=0

# LiveTalking Avatar Service (Separate microservice)
LIVETALKING_BASE_URL=http://127.0.0.1:8010

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./vyra.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
